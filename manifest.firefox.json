{
  "manifest_version": 2,
  "name": "Gmail CC Warn",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "gmail-cc-warn@adamyonk.dev"
    }
  },
  "permissions": [
    "storage",
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "content/observer.js",
    "content/parser.js",
    "content/rules.js",
    "content/ui.js",
    "shared/storage.js",
    "shared/defaults.js"
  ]
}
