{
  "manifest_version": 3,
  "name": "Gmail CC/To Recipient Warning",
  "version": "0.1.0",
  "description": "Warns when Gmail compose recipients risk leaking addresses.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/observer.js",
        "content/parser.js",
        "content/rules.js",
        "content/ui.js",
        "shared/storage.js",
        "shared/defaults.js"
      ],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
